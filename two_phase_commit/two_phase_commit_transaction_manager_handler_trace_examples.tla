---- MODULE two_phase_commit_transaction_manager_handler_trace_examples ----

(* Traces the fuzzer took, which between them take every kind of step. *)

EXTENDS two_phase_commit_transaction_manager_handler_trace

Examples ==
    << \* A commit through the handler's own write
       << [ handler |-> "Start" ],
          [ environment |-> "Reply", decision |-> "None" ],
          [ environment |-> "Vote", rm |-> 1, vote |-> "Prepared" ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "ReadDecision" ],
            outcome |-> [ kind |-> "Received",
                          message |-> [ kind |-> "Reply", decision |-> "None" ] ] ],
          [ handler |-> "Collect" ],
          [ handler |-> "RequestPrepare", rm |-> 0 ],
          [ environment |-> "Vote", rm |-> 0, vote |-> "Prepared" ],
          [ handler |-> "RequestPrepare", rm |-> 1 ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "Prepare", rm |-> 1 ],
            outcome |-> [ kind |-> "Received",
                          message |-> [ kind |-> "Vote", rm |-> 1, vote |-> "Prepared" ] ] ],
          [ handler |-> "ReceivePrepared", rm |-> 1 ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "Prepare", rm |-> 0 ],
            outcome |-> [ kind |-> "Received",
                          message |-> [ kind |-> "Vote", rm |-> 0, vote |-> "Prepared" ] ] ],
          [ handler |-> "ReceivePrepared", rm |-> 0 ],
          [ handler |-> "Commit" ],
          [ environment |-> "Reply", decision |-> "Committed" ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "WriteDecision", decision |-> "Committed" ],
            outcome |-> [ kind |-> "Received",
                          message |-> [ kind |-> "Reply", decision |-> "Committed" ] ] ],
          [ handler |-> "Learn", decision |-> "Committed" ],
          [ handler |-> "Broadcast", rm |-> 0 ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "Commit", rm |-> 0 ],
            outcome |-> [ kind |-> "Acknowledged" ] ],
          [ handler |-> "Broadcast", rm |-> 1 ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "Commit", rm |-> 1 ],
            outcome |-> [ kind |-> "Acknowledged" ] ] >>,

       \* A read that fails
       << [ handler |-> "Start" ],
          [ environment |-> "Decide", decision |-> "Aborted" ],
          [ environment |-> "Reply", decision |-> "Aborted" ],
          [ environment |-> "Vote", rm |-> 1, vote |-> "Refused" ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "ReadDecision" ],
            outcome |-> [ kind |-> "Unavailable" ] ] >>,

       \* An abort on a refusal
       << [ handler |-> "Start" ],
          [ environment |-> "Vote", rm |-> 1, vote |-> "Refused" ],
          [ environment |-> "Vote", rm |-> 0, vote |-> "Prepared" ],
          [ environment |-> "Reply", decision |-> "None" ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "ReadDecision" ],
            outcome |-> [ kind |-> "Received",
                          message |-> [ kind |-> "Reply", decision |-> "None" ] ] ],
          [ handler |-> "Collect" ],
          [ handler |-> "RequestPrepare", rm |-> 0 ],
          [ environment |-> "Reply", decision |-> "Aborted" ],
          [ handler |-> "RequestPrepare", rm |-> 1 ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "Prepare", rm |-> 1 ],
            outcome |-> [ kind |-> "Received",
                          message |-> [ kind |-> "Vote", rm |-> 1, vote |-> "Refused" ] ] ],
          [ handler |-> "Abort" ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "WriteDecision", decision |-> "Aborted" ],
            outcome |-> [ kind |-> "Received",
                          message |-> [ kind |-> "Reply", decision |-> "Aborted" ] ] ],
          [ handler |-> "Learn", decision |-> "Aborted" ],
          [ handler |-> "Broadcast", rm |-> 0 ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "Abort", rm |-> 0 ],
            outcome |-> [ kind |-> "Unavailable" ] ],
          [ handler |-> "Broadcast", rm |-> 1 ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "Abort", rm |-> 1 ],
            outcome |-> [ kind |-> "Acknowledged" ] ] >>,

       \* A timeout
       << [ handler |-> "Start" ],
          [ environment |-> "Reply", decision |-> "None" ],
          [ environment |-> "Vote", rm |-> 0, vote |-> "Prepared" ],
          [ environment |-> "Vote", rm |-> 1, vote |-> "Prepared" ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "ReadDecision" ],
            outcome |-> [ kind |-> "Received",
                          message |-> [ kind |-> "Reply", decision |-> "None" ] ] ],
          [ handler |-> "Collect" ],
          [ handler |-> "RequestPrepare", rm |-> 0 ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "Prepare", rm |-> 0 ],
            outcome |-> [ kind |-> "Received",
                          message |-> [ kind |-> "Vote", rm |-> 0, vote |-> "Prepared" ] ] ],
          [ handler |-> "RequestPrepare", rm |-> 1 ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "Prepare", rm |-> 1 ],
            outcome |-> [ kind |-> "Unavailable" ] ],
          [ handler |-> "Timeout" ],
          [ environment |-> "Decide", decision |-> "Committed" ],
          [ environment |-> "Pair",
            request |-> [ kind |-> "WriteDecision", decision |-> "Aborted" ],
            outcome |-> [ kind |-> "Unavailable" ] ] >>
    >>

====
